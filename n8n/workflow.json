        "toEmail": "={{ $('Webhook').item.json.body.email }}",
        "subject": "¡Bienvenido! Tenemos un mensaje para ti",
        "emailFormat": "text",
        "text": "={{ $json.response }}",
        "options": {}
      },
      "id": "1b0f6c1e-0000-4000-8000-000000000003",
